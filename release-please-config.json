{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "45733cd4e64b227ade4f42c30f6b4bdd27e5d88d",
  "release-type": "simple",
  "include-v-in-tag": false,
  "include-component-in-tag": false,
  "versioning": "prerelease",
  "prerelease": true,
  "prerelease-type": "rc",
  "release-as": "7.0.0-rc.7",
  "draft": true,
  "force-tag-creation": true,
  "pull-request-title-pattern": "chore${scope}: release ${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "build",
      "section": "Build system"
    },
    {
      "type": "ci",
      "section": "Continuous integration"
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Maintenance",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "package-name": "HeadDB",
      "extra-files": [
        {
          "type": "generic",
          "path": "pom.xml"
        },
        {
          "type": "generic",
          "path": "headdb-api/pom.xml"
        },
        {
          "type": "generic",
          "path": "headdb-core/pom.xml"
        },
        {
          "type": "generic",
          "path": "headdb-platforms/pom.xml"
        },
        {
          "type": "generic",
          "path": "headdb-platforms/headdb-paper/pom.xml"
        },
        {
          "type": "generic",
          "path": "version.txt"
        }
      ]
    }
  }
}